// Flux window rules and shortcut for niri. Paste them into your niri
// config, for example ~/.config/niri/config.d/90-user-extra.kdl. A file
// takes 1 binds node, so put the bind into a binds node that it has.

window-rule {
    match app-id="^flux$"
    open-floating true
    default-column-width { fixed 1180; }
    default-window-height { fixed 760; }
}

window-rule {
    match app-id="^flux-screen$"
    open-floating true
}

binds {
    Mod+Alt+F hotkey-overlay-title="Flux" { spawn "flux-cli" "open"; }
}

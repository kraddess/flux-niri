[Desktop Entry]
Type=Application
Name=Flux
GenericName=Phone link
Comment=Share files, clipboard, notifications, and media with your phone
Exec=flux-cli open
Icon=flux
Terminal=false
Categories=Network;Utility;
Keywords=phone;android;clipboard;share;sms;
Actions=quit;start;

[Desktop Action quit]
Name=Quit Flux
Exec=sh -c "flux-cli off; pkill -x flux-gui"

[Desktop Action start]
Name=Start Flux
Exec=flux-cli on
